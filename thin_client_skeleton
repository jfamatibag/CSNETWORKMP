import socket
from network_utils import send_pdu, receive_pdu
import threading

class MTGClient:
    def __init__(self, host='127.0.0.1', port=65432, verbose=True):
        self.host = host
        self.port = port
        self.verbose = verbose
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    def listen_to_server(self):
        """Runs in a separate thread to constantly listen for server updates."""
        try:
            while True:
                pdu = receive_pdu(self.sock, self.verbose)
                if not pdu:
                    print("[CLIENT] Disconnected from server.")
                    break
                
                # Handle incoming server commands (e.g., Update UI, prompt for input)
                # print(f"Server says: {pdu}")
                
        except Exception as e:
            print(f"[CLIENT] Connection error: {e}")

    def start(self):
        self.sock.connect((self.host, self.port))
        print(f"[CLIENT] Connected to server at {self.host}:{self.port}")
        
        # Start listening thread
        listener = threading.Thread(target=self.listen_to_server, daemon=True)
        listener.start()
        
        # Main loop for getting user input and sending PDUs
        try:
            while True:
                # This is just a basic prompt. You'll need to format this based on the game state.
                action = input("Enter action to send (or 'quit'): ")
                if action.lower() == 'quit':
                    break
                    
                # Example PDU structure
                pdu = {
                    "type": "PLAYER_ACTION",
                    "action": action
                }
                send_pdu(self.sock, pdu, self.verbose)
                
        finally:
            self.sock.close()

if __name__ == "__main__":
    client = MTGClient(verbose=True)
    client.start()
def get_card(card_id: str) -> dict:
    """Helper function to fetch card details by ID."""
    return CARD_LIBRARY.get(card_id, None)


def get_cards_by_color(color_code: str) -> list:
    """Helper function to list all cards matching a color code ('R', 'U', 'G', 'W', 'B', 'C')."""
    return [card for card in CARD_LIBRARY.values() if card["color"] == color_code]
import json
import struct
import socket

def send_pdu(sock, pdu_dict, verbose=False):
    """Encodes a dictionary to JSON and sends it with a 32-bit length prefix."""
    if verbose:
        print(f"[VERBOSE] Sending PDU: {json.dumps(pdu_dict)}")
        
    # Convert dictionary to JSON string, then to bytes
    payload = json.dumps(pdu_dict).encode('utf-8')
    
    # Pack the length of the payload into a 4-byte integer (Network byte order/Big-Endian)
    # '!I' means standard size, unsigned int
    header = struct.pack('!I', len(payload))
    
    # Send header followed by payload
    sock.sendall(header + payload)

def receive_pdu(sock, verbose=False):
    """Receives a 32-bit length prefix, then reads the exact JSON payload."""
    # Read the 4-byte header
    header = sock.recv(4)
    if not header:
        return None
        
    # Unpack the 4-byte header to get the payload length
    payload_length = struct.unpack('!I', header)[0]
    
    # Read exactly 'payload_length' bytes
    chunks = []
    bytes_received = 0
    while bytes_received < payload_length:
        chunk = sock.recv(min(payload_length - bytes_received, 4096))
        if not chunk:
            raise RuntimeError("Socket connection broken during payload receive")
        chunks.append(chunk)
        bytes_received += len(chunk)
        
    payload = b''.join(chunks)
    pdu_dict = json.loads(payload.decode('utf-8'))
    
    if verbose:
        print(f"[VERBOSE] Received PDU: {json.dumps(pdu_dict)}")
        
    return pdu_dict